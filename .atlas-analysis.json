  "keyFeatures": [
    "Naira-backed regulated stablecoin (cNGN) with institutional-grade security",
    "Fiat on-ramp via dedicated and temporary virtual Nigerian bank accounts",
    "Fiat off-ramp: redeem cNGN to any Nigerian bank account",
    "On-chain withdrawals to whitelisted external wallet addresses",
    "Cross-chain bridge to move cNGN across EVM, Tron, Solana, and Bantu networks",
    "AES-256-CBC request encryption and Ed25519 response encryption",
    "Test and live environments with environment-scoped API keys",
    "Official SDKs for TypeScript, Python, PHP, and Java"
  ],
  "publicApiSurface": [
    "GET  /balance — retrieve cNGN balance",
    "GET  /transactions — paginated transaction history",
    "GET  /networks — list supported blockchain networks",
    "GET  /virtual-account — get dedicated virtual bank account",
    "POST /virtual-account/temporary — create one-time virtual account",
    "POST /redeemAsset — redeem cNGN to Naira",
    "POST /account/verify — verify Nigerian bank account details",
    "GET  /banks — list supported banks",
    "PUT  /bank-account — update settlement bank account",
    "POST /withdraw — withdraw cNGN to external wallet",
    "GET  /withdraw/verify/{tnxRef} — verify withdrawal status",
    "POST /bridge-quote — get cross-chain bridge fee quote",
    "POST /bridge — bridge cNGN between networks",
    "POST /whitelist — whitelist external wallet address",
    "GET  /whitelisted — list whitelisted addresses"
  ]
}
